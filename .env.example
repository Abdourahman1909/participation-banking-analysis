# Copy this file to `.env` and edit as needed. All values are optional —
# the defaults work for the all-in-one setup (Option A in the README).

# Where the language model (Ollama) is reached.
# Option A (model in Docker on this machine): leave as-is.
# Option B (model on another machine): set to that machine's IP, e.g.
#   OLLAMA_URL=http://192.168.1.42:11434
OLLAMA_URL=http://ollama:11434

# Which model to use (remember to `ollama pull` the same name).
OLLAMA_MODEL=qwen2.5:7b-instruct

# How often the pipeline runs automatically (seconds). 86400 = once a day.
PIPELINE_INTERVAL_SECONDS=86400

# --------------------------------------------------------------------------
# DEV/TEST ONLY — external model API (ADR 0019).
# --------------------------------------------------------------------------
# The competition requires a fully LOCAL/OFFLINE model (spec §5.9, ADR 0009).
# Leave MODEL_PROVIDER unset (or 'ollama') for the real system. The block below
# only exists to unblock extraction/chatbot testing while the local GPU model
# server (ADR 0015) is being set up. NEVER enable it in the competition config.
#
#   MODEL_PROVIDER=groq                        # switches to the external API
#   MODEL_API_KEY=gsk_your_key_here            # get a free key at console.groq.com
#   MODEL_API_BASE=https://api.groq.com/openai/v1   # any OpenAI-compatible base
#   MODEL_NAME=qwen-2.5-32b                     # a model id the provider offers
MODEL_PROVIDER=ollama
